# Discourse API Configuration
# Required for contact form submission

# Your Discourse instance hostname (without https://)
DISCOURSE_HOST=forum.bettertransportqueensland.org

# API Key generated in Discourse Admin > API > New API Key
DISCOURSE_API_KEY=

# Username of the Discourse user that will create the topics
DISCOURSE_API_USERNAME=system

# Optional: Category ID where contact form submissions should be posted
# If not set, topics will be created in the default category
DISCOURSE_CONTACT_CATEGORY_ID=68

# Beta mode — set to "true" to enable beta-only pages and components.
# Must be set before running `next build` or `next dev`.
# Do NOT set this in production deployments.
NEXT_PUBLIC_IS_BETA=false

# Secret shared with the Discourse webhook (Admin > API > Webhooks).
# Required by /api/discourse-webhook; the route returns 503 when unset.
DISCOURSE_WEBHOOK_SECRET=

# Where the Discourse topic cache is written. Must be writable by the runtime
# user; the app falls back to memory-only (with a warning) if it is not.
# Defaults to <tmpdir>/btq-discourse-cache.
DISCOURSE_CACHE_DIR=

# Refetch a cached topic once it is this old, even when the category index
# shows no change. This is what bounds staleness if a webhook is missed,
# because an edit deep in a long post changes none of the index fields.
DISCOURSE_TOPIC_MAX_AGE_SECONDS=3600

# How long a category index is trusted before refetching.
DISCOURSE_CATEGORY_TTL_SECONDS=60

# Set to "false" to skip warming the Discourse cache at startup.
DISCOURSE_PREFETCH_ON_START=true
